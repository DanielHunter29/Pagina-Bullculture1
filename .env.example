# ==========================================================================
# BULLCULTURE — Plantilla de variables de entorno
# Copia este archivo a `.env` y rellena los valores reales.
# `.env` NUNCA se sube al repositorio (está en .gitignore).
# ==========================================================================

# --- Django ---
# Genera una clave con: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
# dev | prod  -> selecciona config.settings.dev o config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=True
# Hosts permitidos separados por coma (en prod: tu dominio real)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Admin (M8) ---
# URL del admin NO predecible (termina en "/", no empieza con "/").
# En producción usa un valor aleatorio propio, p.ej. panel-9f3ax7/
ADMIN_URL=gestion/
# 2FA (TOTP) del admin. OBLIGATORIO en producción: prod no arranca sin él salvo
# ALLOW_ADMIN_WITHOUT_2FA=True (solo emergencias). Enrola con: manage.py setup_2fa <usuario>
ADMIN_2FA_ENABLED=False
# Bloqueo por intentos fallidos de login
AXES_ENABLED=True
AXES_FAILURE_LIMIT=5

# --- Proxy y caché ---
# Nº de proxies de confianza delante del backend que añaden X-Forwarded-For.
# dev (conexión directa) = 0; prod detrás de nginx/traefik = 1 (valor por defecto en prod).
TRUSTED_PROXY_COUNT=0
# Redis para el rate limiting compartido. docker compose ya lo define; obligatorio en prod.
# Fuera de Docker puedes dejarlo vacío (usa caché en memoria).
REDIS_URL=

# --- Pedidos: mantenimiento periódico (comando run_maintenance) ---
# Horas tras las que un pedido pendiente se marca como expirado.
PENDING_ORDER_TTL_HOURS=24
# Días durante los que se reintenta un correo de confirmación fallido.
EMAIL_RETRY_MAX_AGE_DAYS=3

# --- Alertas internas (pedido pagado sin stock, etc.) ---
# Correos separados por coma. Vacío = se avisa a los usuarios staff con correo.
STAFF_ALERT_EMAILS=

# --- CORS (solo el dominio del frontend puede consumir la API) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Base de datos PostgreSQL ---
POSTGRES_DB=bullculture
POSTGRES_USER=bullculture
POSTGRES_PASSWORD=cambia-esta-password-de-db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Frontend (Next.js) ---
# URL pública de la API que consume el navegador
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# URL pública del frontend (para redirecciones de pago de WOMPI)
FRONTEND_URL=http://localhost:3000
# URL pública del sitio (SEO: canonical, sitemap, JSON-LD, OG) — build del frontend
NEXT_PUBLIC_SITE_URL=https://bullculture.co
# Orígenes HTTPS de confianza para el CSRF del admin (prod). Vacío = https://<cada ALLOWED_HOST>
CSRF_TRUSTED_ORIGINS=

# ==========================================================================
# Los siguientes se usan en módulos posteriores (déjalos listos):
# ==========================================================================
# --- Pagos WOMPI (M6) ---
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
# Cada webhook se confirma consultando la transacción a la API de WOMPI.
WOMPI_VERIFY_WITH_API=True
# Vacío = sandbox o producción según la llave pública (pub_test_ → sandbox).
WOMPI_API_URL=

# --- Cloudinary (M9) ---
CLOUDINARY_URL=

# --- Correo transaccional (M7) — SMTP de Resend o SendGrid ---
# Resend:   EMAIL_HOST=smtp.resend.com   EMAIL_HOST_USER=resend    EMAIL_HOST_PASSWORD=<API key>
# SendGrid: EMAIL_HOST=smtp.sendgrid.net EMAIL_HOST_USER=apikey    EMAIL_HOST_PASSWORD=<API key>
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
# Alternativamente, si usas Resend, puedes dejar la API key aquí:
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=BULLCULTURE <no-reply@bullculture.co>
