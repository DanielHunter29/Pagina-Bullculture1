# ==========================================================================
# BULLCULTURE — Plantilla de variables de entorno
# Copia este archivo a `.env` y rellena los valores reales.
# `.env` NUNCA se sube al repositorio (está en .gitignore).
# ==========================================================================

# --- Django ---
# Genera una clave con: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
# dev | prod  -> selecciona config.settings.dev o config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=True
# Hosts permitidos separados por coma (en prod: tu dominio real)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- CORS (solo el dominio del frontend puede consumir la API) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Base de datos PostgreSQL ---
POSTGRES_DB=bullculture
POSTGRES_USER=bullculture
POSTGRES_PASSWORD=cambia-esta-password-de-db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Frontend (Next.js) ---
# URL pública de la API que consume el navegador
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# URL pública del frontend (para redirecciones de pago de WOMPI)
FRONTEND_URL=http://localhost:3000

# ==========================================================================
# Los siguientes se usan en módulos posteriores (déjalos listos):
# ==========================================================================
# --- Pagos WOMPI (M6) ---
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=

# --- Cloudinary (M9) ---
CLOUDINARY_URL=

# --- Correo transaccional (M7) — SMTP de Resend o SendGrid ---
# Resend:   EMAIL_HOST=smtp.resend.com   EMAIL_HOST_USER=resend    EMAIL_HOST_PASSWORD=<API key>
# SendGrid: EMAIL_HOST=smtp.sendgrid.net EMAIL_HOST_USER=apikey    EMAIL_HOST_PASSWORD=<API key>
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
# Alternativamente, si usas Resend, puedes dejar la API key aquí:
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=BULLCULTURE <no-reply@bullculture.co>
